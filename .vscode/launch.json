{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "macOS: Debug active CMake target",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "MIMode": "lldb",
            "stopAtEntry": false,
            "externalConsole": false
        },
        {
            "name": "Windows: Debug active CMake target",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        }
    ]
}
